# Local development values only. Replace JWT_SECRET with a random value before use.
EDGE_HTTP_ADDR=:8080
CORE_GRPC_ADDR=:9090
CORE_GRPC_TARGET=core:9090
CORE_METRICS_ADDR=:9091
DATABASE_URL=postgres://livedrop:livedrop@postgres:5432/livedrop?sslmode=disable
POSTGRES_DB=livedrop
POSTGRES_USER=livedrop
POSTGRES_PASSWORD=livedrop
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_TLS=false
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
RATE_LIMIT_RPS=10
RESERVE_TTL=30
